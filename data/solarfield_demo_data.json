  "process": [
    {
      "step": 1,
      "title": "Tell us about the roof",
      "body": "Send roof dimensions, location, roof covering and a rough power goal, or build a cart if you already know what you want.",
      "caveat": "We suggest equipment from the catalog. That is not a system design: string layout, roof load and grid registration are checked by your installer."
    },
    {
      "step": 2,
      "title": "Confirm the list",
      "body": "You get a written equipment list with prices and the lead time for each item. Nothing is ordered until you confirm it.",
      "caveat": "Prices can change between quote and confirmation if a vendor changes theirs. The quote states how long it is held."
    },
    {
      "step": 3,
      "title": "We source it",
      "body": "After confirmation we order each item from its vendor and arrange delivery to your address or your installer's.",
      "caveat": "We hold no stock. Lead times depend on the vendor and are confirmed per order, not promised up front."
    },
    {
      "step": 4,
      "title": "A qualified installer fits it",
      "body": "Installation is done by an independent, qualified installer you appoint. We send them the datasheets and manuals for the delivered equipment.",
      "caveat": "SOLARFIELD does not install, commission or register systems, and does not employ installers."
    }
  ],
